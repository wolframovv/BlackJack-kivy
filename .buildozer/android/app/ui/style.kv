#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<Lbl>:
    font_name: 'Bebas'
    font_size: sp(18)
    text_size: self.size
    halign: 'center'
    valign: 'middle'
    padding_x: dp(6)

<StyledButton>:
    background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_disabled_down: ''
    background_color: 0, 0, 0, 0
    font_name: 'Bebas'
    font_size: sp(20)
    color: root.text_color
    disabled_color: .65, .65, .65, 1
    text_size: self.width - dp(12), None
    halign: 'center'
    shorten: True
    canvas.before:
        Color:
            rgba: root.current_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

<Panel>:
    orientation: 'vertical'
    padding: dp(12)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0, 0, 0, .78
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: 1, .843, 0, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            width: dp(1.5)

<LimitedInput>:
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: 0, 0, 0, 1
    cursor_color: 0, 0, 0, 1
    hint_text_color: .45, .45, .45, 1
    font_size: sp(18)
    multiline: False
    write_tab: False
    padding: [dp(12), max(0, (self.height - self.line_height) / 2), dp(12), 0]
    canvas.before:
        Color:
            rgba: .94, .94, .94, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: self.disabled_foreground_color if self.disabled else (self.hint_text_color if not self.text else self.foreground_color)

<LeaderRow>:
    size_hint_y: None
    height: dp(32)
    padding: [dp(8), 0]
    canvas.before:
        Color:
            rgba: root.bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]

<HighlightBox>:
    canvas:
        Color:
            rgba: 1, 1, 0, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(10))
            width: dp(2)

<DimOverlay>:
    canvas:
        Color:
            rgba: 0, 0, 0, .6
        Rectangle:
            pos: self.pos
            size: self.size

<FadeOverlay>:
    canvas:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

<CardWidget>:
    size_hint: None, None
    canvas.before:
        PushMatrix
        Rotate:
            angle: root.angle
            origin: self.center_x, self.center_y
        Scale:
            x: root.sx
            y: 1
            z: 1
            origin: self.center_x, self.center_y
        Color:
            rgba: root.fallback_bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
    canvas.after:
        PopMatrix
    Image:
        source: root.img_source
        pos: root.pos
        size: root.size
        fit_mode: 'fill'
        opacity: 1 if root.has_image else 0
    Label:
        text: root.fallback_text
        color: root.fallback_color
        pos: root.pos
        size: root.size
        font_size: root.height * root.font_scale
        text_size: root.width - dp(4), None
        halign: 'center'
        opacity: 0 if root.has_image else 1

<TurnBoard>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
    canvas.after:
        Color:
            rgba: 1, .84, 0, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(8))
            width: dp(1.5)
